# ==============================================================================
# Pune SMB Brevo Cold Email Outreach Environment Configuration
# ==============================================================================

# Brevo Transactional Email API Key (from Brevo -> SMTP & API -> API Keys)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Sender Details (Must be authenticated domain on Brevo)
SENDER_EMAIL=poonam@yourdomain.com
SENDER_NAME=Poonam

# Reply-To Inbox (Where lead replies will be received and monitored via IMAP)
REPLY_TO_EMAIL=poonam@yourdomain.com

# IMAP Configuration for Reply Monitoring
IMAP_HOST=imap.gmail.com
IMAP_USER=poonam@yourdomain.com
IMAP_APP_PASSWORD=your_app_password_here

# Sender Physical Address & Phone (Required for CAN-SPAM / legal compliance)
SENDER_ADDRESS=Baner Road, Pune, Maharashtra 411045, India
SENDER_PHONE=+91 98220 12345

# ==============================================================================
# Next.js / Vercel Configuration
# ==============================================================================

# Public URL of the deployed Vercel site (used for OG tags and pipeline.py)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
DEMO_BASE_URL=http://localhost:3000

# Upstash Redis (from Vercel Storage tab → Add Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Admin panel secret key (generate a long random string, e.g. openssl rand -hex 32)
ADMIN_KEY=your_long_random_admin_secret_here

